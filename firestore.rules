rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 명예의 전당 (Hall of Fame) 랭킹 데이터 규칙
    match /hallOfFame/{document} {
      // 누구나 랭킹 정보 읽기 가능
      allow read: if true;
      
      // 누구나 랭킹 기록 생성 가능 (새 랭킹 등록)
      allow create: if request.resource.data.score >= 0 
                    && request.resource.data.score <= 10
                    && request.resource.data.timeSec > 0;
                    
      // 타인의 명예의 전당 기록 수정 및 삭제 금지 (데이터 보안 보호)
      allow update, delete: if false;
    }
    
    // 사용자 개인별 프로필/기록 문서 (필요 시 확장)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
